{
  "name": "patchpay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patchpay",
      // To self-host: run `wrangler d1 create patchpay` and put your own id here.
      "database_id": "2920d2cf-558e-47d0-ad05-872bf5eb2acc",
      "migrations_dir": "migrations"
    }
  ]
}
